PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/finanzas_personales
# Producción: usa una cadena PostgreSQL con SSL habilitado.
DATABASE_SSL=false
# Genera uno distinto por entorno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_value_of_at_least_32_characters
JWT_EXPIRES_IN=24h
# En producción, lista exacta separada por comas. Ej.: https://tuapp.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
DB_POOL_MAX=5
# En Vercel: DATABASE_SSL=true y DB_POOL_MAX=1. Nunca subas tu .env real.
