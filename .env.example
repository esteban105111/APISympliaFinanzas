PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/finanzas_personales
# Producción: usa una cadena PostgreSQL con SSL habilitado.
DATABASE_SSL=false
# Genera uno distinto por entorno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_value_of_at_least_32_characters
JWT_EXPIRES_IN=24h
# En producción, lista exacta separada por comas. Ej.: https://tuapp.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
DB_POOL_MAX=5
# OAuth client IDs from Google Auth Platform (public identifiers, not secrets).
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# OpenAI queda solo en el backend; nunca la incluyas en Flutter ni en el APK.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini
# Recuperación de contraseña con Resend (en local, si se omiten, el código aparece en la terminal).
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Symplia Finanzas <no-reply@tudominio.com>
# En Vercel: DATABASE_SSL=true y DB_POOL_MAX=1. Nunca subas tu .env real.
